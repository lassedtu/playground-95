{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "three-four-go",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Free plan only: SQLite-backed Durable Objects, nothing paid.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "RECORDS", "class_name": "Records" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Directory", "Records"] }],
  "vars": {
    // Sites allowed to connect (comma-separated, * matches anything in a
    // part of the address). Requests without an Origin (scripts) are allowed.
    "ALLOWED_ORIGINS": "http://localhost:3000,https://playground-95.vercel.app"
  }
}
